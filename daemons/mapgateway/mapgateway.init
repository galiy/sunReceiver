#!/bin/sh /etc/rc.common
# OpenWrt procd init для mapgateway (замена mapgateway.service/systemd).
# МАП (FTDI USB-serial) публикуется как Modbus TCP :502.
START=95
STOP=05
USE_PROCD=1
PROG=/usr/sbin/mapgateway

start_service() {
	# Задержка до появления маршрута по умолчанию: удалённый syslog (logd -r)
	# подключается по сети позже, и без этого стартовые строки демона не
	# долетают до лог-сервера. Максимум 15 с.
	local i=0
	while [ $i -lt 15 ] && ! ip route show default 2>/dev/null | grep -q .; do
		sleep 1; i=$((i + 1))
	done
	sleep 2

	procd_open_instance
	# Устройство — автопоиск (/dev/ttyUSB*, /dev/ttyACM*, /dev/serial/by-id).
	procd_set_param command "$PROG" -b 115200 -p 502
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
