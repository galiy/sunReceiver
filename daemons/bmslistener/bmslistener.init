#!/bin/sh /etc/rc.common
# OpenWrt procd init для bmslistener (замена bmslistener.service/systemd).
# Публикует состояние ANT BMS в SysV shm (ключ 2018); читается CGI read_bms
# через uhttpd (/read_bms.php).
START=96
STOP=04
USE_PROCD=1
PROG=/usr/sbin/bmslistener

start_service() {
	# Задержка до появления маршрута по умолчанию: удалённый syslog (logd -r)
	# подключается по сети позже, и без этого стартовые строки демона не
	# долетают до лог-сервера. Максимум 15 с.
	local i=0
	while [ $i -lt 15 ] && ! ip route show default 2>/dev/null | grep -q .; do
		sleep 1; i=$((i + 1))
	done
	sleep 2

	procd_open_instance
	procd_set_param command "$PROG"
	# Рестарт при падении (не чаще раза в 5 с), как Restart=on-failure.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
