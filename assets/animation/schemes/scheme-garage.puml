@startuml
'
' Общая схема №2: Сеть → Счётчик CE308 → «Сеть гаража» (развилка) → Гараж + инверторы.
' «Сеть гаража» — соединитель: связывает CE308, Гараж и все инверторы (в гараже).
' Развилка — в узле «Сеть гаража»: одна линия вправо в Гараж, вторая вниз к шине инверторов.
'
' Связи — ЛИНИИ (не стрелки): мощность может идти в обе стороны.
' Каждая связь = анимированная линия с бегущим током и подписью мощности (1/с).
'
top to bottom direction

skinparam rectangle {
  BackgroundColor #f2f4f6
  BorderColor #2c2f33
  RoundCorner 8
}
skinparam arrow {
  Color #3a4752
  Thickness 2
}
skinparam shadowing false

rectangle "Сеть" as grid
rectangle "Счётчик CE308" as meter
' «Сеть гаража» — узел-соединитель справа от CE308: CE308, шина инверторов, Гараж.
' В анимации изображается кружком той же толщины, что дорожки тока.
rectangle "Сеть гаража" as garage_net
rectangle "Гараж" as garage

grid -- meter : "P счётчика (CE308) = ce308_active_power"
meter -- garage_net : "P счётчика (CE308) = ce308_active_power"
garage_net -- garage : "P гаража (нагрузка) = ce308_active_power + Σ ac_active_power"

rectangle "Инвертор Sofar" as inv1
rectangle "Инвертор Deye" as inv2
rectangle "Инвертор Deye" as inv3

rectangle "Солнечная панель" as pv1
rectangle "Солнечная панель" as pv2
rectangle "Солнечная панель" as pv3

garage_net -- inv1 : "P инвертора = ac_active_power"
garage_net -- inv2 : "P инвертора = ac_active_power"
garage_net -- inv3 : "P инвертора = ac_active_power"
pv1 -- inv1 : "P_PV инвертора"
pv2 -- inv2 : "P_PV инвертора"
pv3 -- inv3 : "P_PV инвертора"

@enduml